# ==============================================================================
# COALINTEL — AI-Powered Mining Intelligence & Reporting Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Configuration
PROJECT_NAME="COALINTEL"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="coalintel-super-secret-jwt-signing-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480 # 8 Hours

# Database Configuration (PostgreSQL / SQLite fallback)
# Set DATABASE_URL explicitly for Docker, Render, Supabase, or local PostgreSQL.
# The password may be omitted when libpq/pgpass.conf supplies it.
# Local acceptance example:
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/coalintel_step1_acceptance
# Alternatively set POSTGRES_USER/POSTGRES_DB/POSTGRES_HOST/POSTGRES_PORT and
# optionally POSTGRES_PASSWORD; the backend composes DATABASE_URL from them.
# Supabase Direct (Port 5432): postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Supabase Pooler (Port 6543): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=coalintel_step1_acceptance
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/coalintel_step1_acceptance

# Storage Configuration (Local Filesystem vs Supabase Storage)
# Options for STORAGE_PROVIDER: "local" (default for dev/tests), "supabase" (for production)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./storage/uploads"
CHROMA_DB_DIR="./storage/chroma_db"
REPORT_DIR="./storage/reports"

# Supabase Storage (Backend-only private bucket configuration)
# Note: NEVER prefix service-role key with NEXT_PUBLIC_* or expose to frontend client.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_DOCUMENTS_BUCKET="documents"
SUPABASE_REPORTS_BUCKET="reports"

# LLM Provider Abstraction Configuration
# Options for LLM_PROVIDER: "gemini", "openai", "degraded"
LLM_PROVIDER="gemini"
LLM_API_KEY="your-api-key-here"
LLM_MODEL_NAME="gemini-3.6-flash"
LLM_TIMEOUT_SECONDS=10.0

# Retrieval & RAG Hyperparameters
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
RRF_K_CONSTANT=60
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Target Validation & Conflict Thresholds
ARITHMETIC_WARNING_THRESHOLD_PCT=5.0
CROSS_DOC_CONFLICT_THRESHOLD_PCT=1.0

# Step 2B isolated Document AI service (Python 3.12 Paddle runtime)
# The Python 3.14 backend calls this boundary over localhost/HTTP and falls
# back to the existing Tesseract path when the service is unavailable.
DOCUMENT_AI_ENABLED=True
DOCUMENT_AI_URL=http://127.0.0.1:8765
DOCUMENT_AI_CONNECT_TIMEOUT_SECONDS=0.5
DOCUMENT_AI_OCR_TIMEOUT_SECONDS=120.0
DOCUMENT_AI_STRUCTURE_TIMEOUT_SECONDS=180.0
DOCUMENT_AI_ENABLE_STRUCTURE=True
DOCUMENT_AI_STRUCTURE_MODE=table_hint
DOCUMENT_AI_FALLBACK_TO_TESSERACT=True
DOCUMENT_AI_DEVICE=cpu
